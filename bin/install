#!/bin/sh
# Build and install infra-token-factory. After a rebuild, macOS asks once per
# Keychain item for your login password: click Always Allow.
set -eu
cd "$(dirname "$0")/.."
dest="$HOME/.local/share/infra-token-factory"
mkdir -p build "$dest" "$HOME/.local/bin"
xcrun swiftc -O -parse-as-library Sources/*.swift -o build/infra-token-factory
install -m 711 build/infra-token-factory "$dest/infra-token-factory"
ln -sf "$dest/infra-token-factory" "$HOME/.local/bin/infra-token-factory"
rm -rf build
echo "installed=$dest/infra-token-factory"
