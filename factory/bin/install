#!/bin/sh
# Build the gondr token factory (macOS). `gondr token` runs it from the path below.
# After a rebuild, macOS asks once per Keychain item for your login password: click Always Allow.
set -eu
cd "$(dirname "$0")/.."
dest="$HOME/.local/share/gondr"
prefix="${KEYCHAIN_PREFIX:-gondr-token}"
case "$prefix" in
  *[!A-Za-z0-9._-]* | "") echo "KEYCHAIN_PREFIX may hold only letters, digits, '.', '_' and '-'" >&2; exit 1 ;;
esac
mkdir -p build "$dest"
printf '/// Start of every Keychain service name. bin/install writes this file.\nlet keychainPrefix = "%s"\n' "$prefix" > build/KeychainPrefix.swift
xcrun swiftc -O -parse-as-library Sources/*.swift build/KeychainPrefix.swift -o build/gondr-factory
install -m 711 build/gondr-factory "$dest/gondr-factory"
rm -rf build
echo "installed=$dest/gondr-factory keychain_prefix=$prefix"
